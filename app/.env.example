# Non-sensitive frontend grading Gateway configuration.
# Do not put provider API keys or secrets in VITE_* variables.
VITE_GRADING_MODE=real
VITE_GRADING_API_BASE=http://127.0.0.1:8790
VITE_GRADING_QUEUE_MODE=adaptive-v1
VITE_GRADING_MAX_IN_FLIGHT=4

# Class review is currently an in-process local prototype.
# Do not add service tokens or provider secrets to VITE_* variables.
VITE_CLASS_REVIEW_MODE=local-fake

# Only use this explicit switch for the original in-memory business demo.
# Production builds ignore the bypass and always require an account session.
# VITE_AUTH_MODE=local-demo
