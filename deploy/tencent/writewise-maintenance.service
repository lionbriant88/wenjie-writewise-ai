[Unit]
Description=WriteWise bounded maintenance (disabled after restore)
After=network.target postgresql.service

[Service]
Type=oneshot
User=wj-app
Group=wj-app
WorkingDirectory=/srv/writewise/current
EnvironmentFile=/etc/writewise/runtime.env
ExecStart=@NODE@ platform-api/src/standalone/maintenance.js
TimeoutStartSec=360
TimeoutStopSec=360
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/writewise
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal
