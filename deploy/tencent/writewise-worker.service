[Unit]
Description=WriteWise single durable worker (disabled after restore)
After=network.target postgresql.service

[Service]
Type=simple
User=wj-app
Group=wj-app
WorkingDirectory=/srv/writewise/current
EnvironmentFile=/etc/writewise/runtime.env
ExecStart=@NODE@ platform-api/src/standalone/worker.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=360
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/writewise
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal

# Deliberately no Install target. Starting requires an explicit operator action.
