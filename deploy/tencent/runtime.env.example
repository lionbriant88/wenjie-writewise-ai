NODE_ENV=production
PILOT_DEPLOYMENT_MODE=standalone
PORT=8793
APP_ORIGIN=https://wenjiezuowen.cn
AUTH_STORAGE=postgres
AUTH_RATE_LIMIT_SECRET=REPLACE_WITH_NEW_SECRET
DATABASE_URL=postgresql://NEW_RESTRICTED_ROLE:REPLACE@127.0.0.1:5432/NEW_TARGET_DATABASE
# Strict TLS required; install matching local server cert/key and CA beforehand.
DATABASE_CA_CERT=REPLACE_WITH_PEM_CA
TRUST_LOOPBACK_PROXY=1
PILOT_MVP_ENABLED=1
PILOT_STORAGE_BACKEND=disk
PILOT_QUEUE_BACKEND=postgres
PILOT_MIGRATION_GATE_ENABLED=1
PILOT_DISK_ROOT=/var/lib/writewise/originals
PILOT_FILE_SIGNING_KEY=REPLACE_WITH_INDEPENDENT_NEW_SECRET
PILOT_WORKER_HEARTBEAT_FILE=/var/lib/writewise/run/worker.json
PILOT_WORKER_ENABLED=0
PILOT_MAINTENANCE_ENABLED=0
GRADING_PROVIDER=deepseek
DEEPSEEK_API_KEY=REPLACE_VIA_VERIFIED_ENCRYPTED_CHANNEL
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_COMPLETION_TOKENS=16384
